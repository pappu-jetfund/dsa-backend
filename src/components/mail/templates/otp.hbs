<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OTP Verification</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f4f4; font-family:Arial, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f4;">
    <tr>
      <td align="center">

        <table width="800" cellpadding="0" cellspacing="0" border="0"
          style="background-color:#ffffff; width:100%; max-width:800px;">

          <!-- Header Image -->
          <tr>
            <td align="center" style="padding:0;">
              <img src="{{SERVER_DOMAIN_NAME_HEADER}}" alt="Header"
                style="display:block; width:100%; max-width:800px; height:auto; border:0;" />
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:40px 30px; text-align:center;">

              <h2 style="margin:0 0 20px; color:#333333; font-size:28px;">
                {{company}}
              </h2>

              <h3 style="margin:0 0 15px; color:#222222; font-size:22px;">
                Your OTP Code
              </h3>

              <p style="margin:0 0 20px; font-size:16px; color:#555555;">
                Use the OTP below to continue:
              </p>

              <div
                style="display:inline-block; padding:15px 30px; font-size:32px; font-weight:bold; letter-spacing:5px; background-color:#f1f7ff; color:#007bff; border-radius:8px; margin-bottom:20px;">
                {{otp}}
              </div>

              <p style="margin:0; color:#777777; font-size:14px;">
                This OTP is valid for 5 minutes.
              </p>

            </td>
          </tr>

          <!-- Footer Image -->
          <tr>
            <td align="center" style="padding:0;">
              <img src="{{SERVER_DOMAIN_NAME_FOOTER}}" alt="Footer"
                style="display:block; width:100%; max-width:800px; height:auto; border:0;" />
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>

</html>