<!DOCTYPE html>
<html>
<body style="margin:0; padding:0; background-color:#f4f4f4;">

  <!-- Outer Wrapper -->
  <table width="100%" cellpadding="0" cellspacing="0" border="0" align="center" style="background-color:#f4f4f4;">
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table width="800" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff; width:100%; max-width:800px;">

          <!-- Header Image -->
          <tr>
            <td align="center" style="padding:0;">
              <img 
                src="{{SERVER_DOMAIN_NAME_HEADER}}" 
                alt="Header"
                width="800"
                style="display:block; width:100%; max-width:800px; height:auto; border:0;"
              >
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:30px; font-family: Arial, sans-serif; font-size:14px; line-height:22px; color:#000;">
              
              <p>Dear {{name}},</p>

              <p>Hope you are doing well.</p>

              <p>
                 As discussed during our telephone conversation on 
                <b>{{commitmentDate}}</b>, you made a commitment to pay on 
                <b>{{paymentDate}}</b>.
                Please make sure you stay true to your valuable words and repay us.
              </p>

              {{!-- <p><strong>NOTE - If your final commitment fails, E-mandate will be activated.</strong></p> --}}

              <br>

              <p>Best regards,</p>
              <p><strong>COLLECTION MANAGER</strong></p>

            </td>
          </tr>

          <!-- Footer Image -->
          <tr>
            <td align="center" style="padding:0;">
              <img 
                src="{{SERVER_DOMAIN_NAME_FOOTER}}" 
                alt="Footer"
                width="800"
                style="display:block; width:100%; max-width:800px; height:auto; border:0;"
              >
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>