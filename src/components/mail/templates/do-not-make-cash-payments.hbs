<!DOCTYPE html>
<html>
  <body>
    <table style="width: 100%; float: left; border: 5px solid #0000000d; padding: 0px 10px;" border="0">

      <tr>
        <td>
          <img src="{{SERVER_DOMAIN_NAME_HEADER}}" style="width: 100%;" />
        </td>
      </tr>

      <tr>
        <td>
          <p>Dear {{name}},</p>

          <p>Request you not to make any payment in cash to any of our representatives.</p>

          <p>
            We do not accept cash payments and any cash payment received from any customer 
            will not be counted as payment and will not be adjusted against your account.
          </p>

          <p>
            If any of our representatives asks for payment in cash, please contact us immediately at {{company_mobile_no}}.
          </p>

          <p><strong>&nbsp;</strong></p>

          <p>Best regards,</p>
          <p>{{company_name_show}} Team</p>
        </td>
      </tr>

      <tr>
        <td>
          <img src="{{SERVER_DOMAIN_NAME_FOOTER}}" style="width: 100%;" />
        </td>
      </tr>

    </table>
  </body>
</html>
