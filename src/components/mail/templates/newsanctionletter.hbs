    <head>
    <meta charset="UTF-8">
    <title>Key Fact Statement</title>

    <style>
        @page {
            size: A4;
            margin: 130px 35px 90px 35px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: "Times New Roman", serif;
            font-size: 12px;
            color: #000;
            line-height: 1.4;
        }

        .header {
            position: fixed;
            top: -110px;
            left: 0;
            right: 0;
            height: 95px;
        }

        .header img {
            width: 100%;
            height: 95px;
            object-fit: contain;
        }

        .footer {
            position: fixed;
            bottom: -75px;
            left: 0;
            right: 0;
            height: 60px;
        }

        .footer img {
            width: 100%;
            height: 60px;
            object-fit: contain;
        }

        h2 {
            text-align: center;
            margin: 0;
            font-size: 16px;
            font-weight: bold;
        }

        h3 {
            text-align: center;
            margin-top: 8px;
            margin-bottom: 12px;
            font-size: 14px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }

        table,
        td,
        th {
            border: 1px solid #000;
        }

        td,
        th {
            padding: 6px;
            vertical-align: top;
        }

        .label {
            width: 40%;
            font-weight: bold;
        }

        .value {
            width: 60%;
        }

        .page-break {
            page-break-after: always;
        }

        .center {
            text-align: center;
        }

        .bold {
            font-weight: bold;
        }
    </style>

</head>
